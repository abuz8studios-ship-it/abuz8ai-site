<script>
// Waitlist capture — posts to the site's ONE data-collecting endpoint
// (/api/waitlist -> Cloudflare D1). Honest fallback: if the request
// fails we say so and give a real path, never a fake confirmation.
// NOTE (2026-07-29): the checkout() helper that posted to /api/stripe-checkout
// was removed with the "Agent Generated" tier. Those 8 SKUs were listed at
// $9–$47 but their deliverables were 380-byte ZIPs containing only a LICENSE
// and a README — no product. They are off the store until a real artifact
// exists. Every remaining card links straight to a Stripe-hosted checkout.

function joinWaitlist(e){
  e.preventDefault();
  var email = document.getElementById('wl-email').value.trim();
  var msg = document.getElementById('wl-msg');
  if(!email || email.indexOf('@')<1){ msg.style.color='var(--amber)'; msg.textContent='Please enter a valid email.'; return false; }
  msg.style.color='var(--muted)'; msg.textContent='Adding you…';
  var payload = JSON.stringify({email:email, product:'qadir-shift', referrer:'store', ts:Date.now()});
  fetch('/api/waitlist', {method:'POST',headers:{'Content-Type':'application/json'},body:payload})
    .then(function(r){ if(r.ok){ done(); } else { fail(); } })
    .catch(function(){ fail(); });
  function done(){ msg.style.color='var(--green)'; msg.textContent="You're on the list. We'll email you at "+email+" with early pricing."; document.getElementById('wl-email').value=''; }
  function fail(){ msg.style.color='var(--amber)'; msg.textContent="Couldn't reach the list right now — email ahmad@abuz8ai.com and we'll add you by hand."; }
  return false;
}
</script>
