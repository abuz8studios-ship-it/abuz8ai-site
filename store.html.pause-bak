<meta name="robots" content="index,follow">
<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="ABUZ8 Store — AI Toolkits, Playbooks & Production Kits">
<meta property="og:description" content="28 instant-download AI products. Secure Stripe checkout, files to your inbox. Every product tested before it's sold.">
<meta property="og:url" content="https://abuz8ai.com/store">
