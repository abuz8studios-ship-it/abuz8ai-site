<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/abuz8-theme.css">
<style>
/* ============================================================
   STORE — page-specific styles ONLY.
   Ported to the unified theme 2026-07-29. This page had shipped its
   own :root palette (#F8FAFC / #2E75B6 / #2C3E50) — the LIGHT scheme
   retired on 2026-07-17 — so clicking "Store" from any other page
   dropped the visitor onto a different-looking website mid-funnel.
   Every colour below now comes from abuz8-theme.css. No new hex.
   ============================================================ */

.hero{padding:70px 0 40px;border-bottom:1px solid var(--border)}
.eyebrow{display:inline-flex;border:1px solid var(--border-gold);color:var(--gold);
  border-radius:999px;padding:6px 12px;font-size:12px;font-weight:700;
  letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}
h1{font-family:var(--font-display);font-size:clamp(2.2rem,5.4vw,4.2rem);line-height:1.05;
  margin:0 0 18px;max-width:980px;color:var(--white)}
.lead{font-size:clamp(1.02rem,2vw,1.2rem);color:var(--dim);max-width:760px;margin:0 0 24px}
.actions{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;
  padding:12px 20px;border-radius:var(--r-sm);font-weight:700;font-size:14px;
  border:1px solid var(--border-gold);background:var(--glass-soft);color:var(--text);
  transition:border-color .3s,color .3s,transform .3s}
.btn:hover{border-color:var(--gold);color:var(--gold-light);transform:translateY(-2px)}
.btn.primary{background:linear-gradient(135deg,var(--gold-dim),var(--gold));
  border-color:var(--gold);color:var(--lapis)}
.btn.primary:hover{color:var(--lapis);filter:brightness(1.08)}

.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:30px}
.stat{border:1px solid var(--border);background:var(--glass-soft);
  border-radius:var(--r-sm);padding:16px}
.stat strong{display:block;color:var(--gold);font-size:26px;line-height:1;
  font-family:var(--font-display)}
.stat span{display:block;color:var(--dim);font-size:12px;margin-top:6px}

.section{padding:48px 0;border-bottom:1px solid var(--border)}
h2{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.3rem);line-height:1.12;
  margin:0 0 6px;color:var(--white)}
.sub{color:var(--dim);max-width:760px;margin:0 0 24px}

.tier-label{display:flex;align-items:baseline;gap:12px;margin:34px 0 14px}
.tier-label:first-of-type{margin-top:6px}
.tier-label h3{font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:var(--gold);margin:0}
.tier-label span{font-size:13px;color:var(--dim)}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(258px,1fr));gap:16px}
.pack{background:var(--glass-soft);border:1px solid var(--border);border-radius:var(--r-md);
  padding:20px;display:flex;flex-direction:column;min-height:100%;
  transition:transform .3s,border-color .3s,box-shadow .3s}
.pack:hover{transform:translateY(-4px);border-color:var(--border-gold);box-shadow:var(--shadow)}
.pack.feature{border-color:var(--border-gold);background:var(--glass)}
.pack h4{font-size:18px;margin:0 0 8px;line-height:1.3;color:var(--white)}
.pack p{color:var(--dim);margin:0 0 14px;font-size:14px}
.pack img.cover{width:100%;border-radius:var(--r-sm);border:1px solid var(--border);
  margin-bottom:12px;aspect-ratio:600/776;object-fit:cover}

.tag{display:inline-flex;width:max-content;border-radius:999px;padding:4px 10px;
  font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px}
.tag.ready{color:var(--green-bright);background:var(--green-glow);
  border:1px solid rgba(47,191,143,.30)}
.tag.best{color:var(--gold-light);background:rgba(201,168,76,.10);border:1px solid var(--border-gold)}

.price{font-family:var(--font-display);font-size:28px;font-weight:700;color:var(--gold);
  margin:auto 0 14px}
.price span{font-family:var(--font-body);font-size:12px;font-weight:500;color:var(--dim)}

.buy{display:inline-flex;align-items:center;justify-content:center;min-height:44px;
  padding:11px 16px;border-radius:var(--r-sm);font-weight:700;font-size:14px;
  background:linear-gradient(135deg,var(--gold-dim),var(--gold));
  border:1px solid var(--gold);color:var(--lapis);transition:filter .3s,transform .3s}
.buy:hover{filter:brightness(1.1);transform:translateY(-1px);color:var(--lapis)}
.details{display:inline-block;margin-left:12px;font-size:13px;color:var(--gold)}
.details:hover{color:var(--gold-light)}

.toolgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.toolcard{border:1px solid var(--border);background:var(--glass-soft);
  border-radius:var(--r-sm);padding:16px}
.toolcard h4{margin:0 0 4px;font-size:15px;color:var(--white)}
.toolcard span{font-size:13px;color:var(--dim)}

.cta{background:var(--glass);border:1px solid var(--border-gold);border-radius:var(--r-lg);
  padding:34px;text-align:center}
.cta h2{margin-bottom:8px}
.wlform{display:flex;gap:10px;max-width:480px;margin:18px auto 0;flex-wrap:wrap;justify-content:center}
.wlform input{flex:1;min-width:220px;min-height:46px;padding:0 14px;border-radius:var(--r-sm);
  border:1px solid var(--border);background:var(--lapis-2);color:var(--text);font-size:15px}
.wlform input::placeholder{color:var(--muted)}
.wlform input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px var(--green-glow)}
.wlmsg{margin-top:12px;font-size:14px;color:var(--green-bright);min-height:18px}

.footer{padding:34px 0;color:var(--dim);font-size:13px}

@media(max-width:850px){
  .stats{grid-template-columns:1fr 1fr}
  .actions .btn{width:100%}
}
</style>
