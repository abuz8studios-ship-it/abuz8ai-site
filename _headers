# ABUZ8AI — Custom response headers for Cloudflare Pages
# See: https://developers.cloudflare.com/pages/configuration/headers/

# ads.txt MUST be served as text/plain for AdSense verification
/ads.txt
  Content-Type: text/plain; charset=utf-8

# robots.txt should also be text/plain
/robots.txt
  Content-Type: text/plain; charset=utf-8

# sitemap.xml should be application/xml
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# Security headers — all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
